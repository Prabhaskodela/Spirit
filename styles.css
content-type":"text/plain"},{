@import url('https://fonts.googleapis.com/css2?family=Dancing+Script:wght@500;600;700&family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap');
:root{color-scheme:dark;--bg:#101116;--panel:#191a23;--panel2:#20212b;--text:#f5f2f8;--muted:#a09eab;--subtle:#757482;--line:#ffffff14;--pink:#ff6da8;--violet:#b17fff;--mint:#a4f0d1;--shadow:0 20px 44px #00000070}
*{box-sizing:border-box}body{margin:0;min-height:100vh;background:radial-gradient(ellipse at 48% -10%,#2b203a 0,transparent 40rem),var(--bg);font-family:'DM Sans',sans-serif;color:var(--text)}button,input,select,textarea{font:inherit}a{color:inherit;text-decoration:none}
.app-frame{max-width:1440px;margin:auto;min-height:100vh;display:flex;flex-direction:column}.topbar{height:72px;padding:0 34px;display:flex;align-items:center;gap:22px;border-bottom:1px solid var(--line);background:rgba(10,13,16,.9);backdrop-filter:blur(12px)}.topline{font-size:10px;letter-spacing:.24em;text-transform:uppercase;color:#aeb9bf;margin:0;opacity:.85}.brand{display:inline-flex;align-items:center;justify-content:center;text-decoration:none}.brand-image{display:block;width:auto;height:54px;max-width:220px;object-fit:contain;filter:drop-shadow(0 10px 18px rgba(135,161,255,.17))}.account-area{display:flex;align-items:center;gap:10px;margin-left:auto}.notification-button,.account-name,.quiet-button{border:1px solid rgba(255,255,255,.08);background:rgba(255,255,255,.02);border-radius:99px;padding:8px 12px;color:#eef2ff;cursor:pointer}.notification-button{width:38px;height:38px;padding:0;display:grid;place-items:center;position:relative}.notification-count{position:absolute;top:-4px;right:-4px;background:#d9e9ff;color:#0d1328;font-size:9px;font-weight:700;border-radius:50%;padding:2px 5px;min-width:17px;text-align:center;border:2px solid #0d1328}.account-name{font-weight:700}.quiet-button{padding:7px 11px}.install-button{margin-left:auto;height:32px;padding:0 11px;border:1px solid rgba(185,204,255,.35);border-radius:9px;background:rgba(154,172,255,.09);color:#eef2ff;font-size:10px;font-weight:600;cursor:pointer}.install-button span{color:#cdd8ff}.auth-wrap{position:relative;overflow:hidden;flex:1;min-height:630px;display:grid;place-items:center;padding:60px 20px}.auth-card{z-index:1;width:min(100%,470px);padding:46px 44px 35px;border:1px solid rgba(146,165,255,.18);background:rgba(12,17,25,.82);border-radius:22px;box-shadow:0 26px 72px rgba(0,0,0,.45);text-align:center}.auth-spark,.welcome-glyph{width:56px;height:56px;display:grid;place-items:center;border:1px solid rgba(185,204,255,.25);margin:0 auto 18px;border-radius:50%;background:rgba(107,131,211,.12);color:#dfe8ff;font-size:26px;box-shadow:0 10px 28px rgba(0,0,0,.26)}.eyebrow{text-transform:uppercase;letter-spacing:.2em;font-size:10px;color:#a8b7d7;margin:0 0 14px}.auth-card h1,.welcome-empty h1{font-size:clamp(2.7rem,5vw,5rem);line-height:.9;margin:0 0 20px;letter-spacing:-.08em}.gradient-text{background:linear-gradient(135deg,#f7fbff,#b7c6ff 45%,#d9e0ff);-webkit-background-clip:text;background-clip:text;color:transparent}.auth-copy{color:#bbc6d8;max-width:360px;margin:0 auto 22px;line-height:1.6}.auth-foot{color:#93a2c3;font-size:12px;margin:18px auto 0;max-width:310px;line-height:1.5}.google-button{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-width:220px;padding:12px 18px;border-radius:12px;border:1px solid rgba(182,198,255,.22);background:linear-gradient(135deg,#f7fbff,#e1e8ff);color:#0a1220;font-weight:700;cursor:pointer}.google-g{font-weight:800;color:#1d4ed8}.button-arrow{font-size:1.1rem}.setup-note{margin-top:16px;border:1px solid rgba(255,127,127,.25);background:rgba(255,96,96,.08);color:#ffd7d7;border-radius:12px;padding:10px 12px;font-size:12px}.workspace{flex:1;display:grid;grid-template-columns:250px minmax(0,1fr);min-height:calc(100vh - 126px)}.sidebar{border-right:1px solid var(--line);padding:28px 17px 22px;display:flex;flex-direction:column;gap:12px;background:rgba(15,18,23,.82)}.side-heading{display:flex;align-items:center;justify-content:space-between}.side-heading h2{margin:4px 0 0;font-size:1.1rem}.join-room-link,.add-room-button,.room-item,.subject-row,.room-tab,.semester-add,.semester-manage,.room-id-chip,.manage-members-button{border:1px solid rgba(255,255,255,.08);background:rgba(255,255,255,.02);border-radius:12px;color:inherit;cursor:pointer}.join-room-link{display:flex;align-items:center;justify-content:center;gap:8px;padding:10px 12px;background:rgba(182,198,255,.05);color:#dfe8ff}.room-list{display:flex;flex-direction:column;gap:8px;min-height:0;overflow:auto}.room-item{display:flex;align-items:center;gap:10px;padding:10px 12px;text-align:left}.room-monogram{width:30px;height:30px;display:grid;place-items:center;border-radius:50%;background:rgba(121,164,255,.16);color:#dfe8ff;font-weight:700}.room-item-copy{display:flex;flex-direction:column;min-width:0}.room-item-copy strong{font-size:.93rem}.room-item-copy span{font-size:.73rem;color:#91a0bd}.room-item.is-active{border-color:rgba(182,198,255,.3);background:rgba(127,146,255,.1)}.sidebar-tip{margin-top:auto;padding-top:12px;border-top:1px solid var(--line);display:flex;align-items:flex-start;gap:8px;color:#9ba9c6;font-size:12px}.sidebar-tip span{color:#dfe8ff}.room-main{min-width:0;padding:30px 34px 48px}.welcome-empty{max-width:690px;margin:110px auto 30px;text-align:center}.welcome-empty h1{font-size:clamp(2.5rem,4vw,4rem);letter-spacing:-.05em}.welcome-empty p{color:#b1bfd7}.welcome-actions{display:flex;justify-content:center;gap:12px;margin-top:28px}.primary-button,.secondary-button,.danger-button{border-radius:11px;padding:10px 16px;border:1px solid rgba(182,198,255,.22);background:rgba(128,166,255,.12);color:#eef2ff;cursor:pointer}.secondary-button{background:rgba(255,255,255,.02)}.danger-button{background:rgba(255,96,96,.08);border-color:rgba(255,127,127,.25);color:#ffd7d7}.room-content{min-width:0}.room-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:18px;padding-bottom:18px;border-bottom:1px solid var(--line)}.room-heading-copy{flex:1;min-width:0}.room-title-row{display:flex;align-items:center;gap:12px;flex-wrap:wrap}.room-title-row h1{margin:0;font-size:clamp(2rem,3vw,3rem);letter-spacing:-.05em}.room-id-chip{padding:7px 10px;font-size:12px}.member-line{margin:8px 0 0;color:#98a7c4;font-size:12px}.semester-control{display:flex;align-items:center;gap:10px}.semester-control label{font-size:10px;letter-spacing:.18em;text-transform:uppercase;color:#a8b7d7}.semester-control select{background:rgba(15,18,23,.85);border:1px solid rgba(255,255,255,.08);border-radius:10px;padding:9px 12px;color:#eef2ff}.semester-add,.semester-manage{padding:9px 10px}.room-tabs{display:flex;gap:22px;border-bottom:1px solid var(--line);margin:20px 0 18px}.room-tab{position:relative;padding:10px 0;border:none;background:none;border-bottom:2px solid transparent;color:#9aabc7;font-weight:600}.room-tab.is-active{color:#eef2ff;border-color:rgba(182,198,255,.55)}.section-top{display:flex;align-items:center;justify-content:space-between;gap:15px;margin-bottom:17px}.section-top h2{font:500 23px 'Space Grotesk',sans-serif;letter-spacing:-.6px;margin:6px 0 0}.subject-layout{display:grid;grid-template-columns:220px minmax(0,1fr);gap:16px}.subject-list{display:flex;flex-direction:column;gap:8px}.subject-row{display:flex;align-items:center;gap:10px;padding:10px 12px;text-align:left}.subject-icon{width:28px;height:28px;display:grid;place-items:center;border-radius:8px;background:rgba(132,166,255,.12);color:#dfe8ff}.subject-row strong{display:block;font-size:.9rem}.subject-row small{display:block;color:#93a2c3;font-size:.72rem;margin-top:2px}.subject-detail{border:1px solid var(--line);background:rgba(255,255,255,.02);border-radius:16px;padding:16px;min-height:260px}.sub-empty{display:grid;place-items:center;text-align:center;height:100%;color:#9aa9c5}.sub-empty>span{font-size:24px;color:#dfe8ff}.footer,.app-footer{margin-top:auto;padding:18px 24px 22px;border-top:1px solid var(--line);display:flex;justify-content:space-between;gap:12px;color:#99aaca;font-size:12px;letter-spacing:.12em;text-transform:uppercase}.app-footer span:first-child{color:#eef2ff}.offline-banner{margin:0;border-bottom:1px solid rgba(255,127,127,.25);background:rgba(255,96,96,.08);color:#ffd7d7;padding:10px 16px;font-size:12px}.toast{position:fixed;left:50%;bottom:22px;transform:translateX(-50%) translateY(20px);opacity:0;pointer-events:none;transition:opacity .18s,transform .18s;background:rgba(13,17,22,.96);border:1px solid rgba(182,198,255,.25);padding:10px 14px;border-radius:12px;color:#eef2ff;box-shadow:0 12px 28px rgba(0,0,0,.3)}.toast.is-visible{opacity:1;transform:translateX(-50%) translateY(0)}
@media (max-width: 620px){
  .topbar{height:62px;padding:0 17px;gap:12px}.topline{display:none}.brand-image{height:38px;max-width:160px}.account-area{gap:6px}.account-name{max-width:105px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.workspace{grid-template-columns:1fr}.sidebar{border-right:none;border-bottom:1px solid var(--line)}.room-main{padding:22px 18px 28px}.room-heading{flex-direction:column;align-items:flex-start}.semester-control{width:100%;justify-content:space-between}.room-tabs{overflow-x:auto}.subject-layout{grid-template-columns:1fr}.app-footer{padding-inline:16px;letter-spacing:.08em}.install-button{padding:0 9px;font-size:9px}}
